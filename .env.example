# Copy to .env and adjust. All values are optional.

# Interface/port published on the host. 127.0.0.1 = only reachable from the host itself.
BIND_ADDRESS=127.0.0.1
PORT=8484

# Timezone for schedules and COROS uploads (IANA name).
TZ=Europe/London

# Sign-in for the web UI. Setting APP_PASSWORD turns on the login page.
# Strongly recommended if BIND_ADDRESS is not 127.0.0.1.
APP_USERNAME=admin
APP_PASSWORD=

# How long a sign-in lasts, in days.
SESSION_DAYS=30
